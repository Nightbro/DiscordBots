[Unit]
Description=Echo Discord Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/DiscordBots/echo-bot
ExecStart=/home/pi/DiscordBots/echo-bot/venv/bin/python bot.py
Restart=on-failure
RestartSec=5
EnvironmentFile=/home/pi/DiscordBots/echo-bot/.env

[Install]
WantedBy=multi-user.target
