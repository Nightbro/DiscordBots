[Unit]
Description=Night Roller Discord Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/DiscordBots/night-roller
ExecStart=/home/pi/DiscordBots/night-roller/venv/bin/python bot.py
Restart=on-failure
RestartSec=5
EnvironmentFile=/home/pi/DiscordBots/night-roller/.env

[Install]
WantedBy=multi-user.target
